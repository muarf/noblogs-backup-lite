#!/usr/bin/env bash
# noblogs — Lanceur multi-OS pour noblogs-backup-lite (Tails / Ubuntu / macOS).
# La logique interactive est en Python (backup/wizard.py) :
#   ./noblogs                  → assistant interactif
#   ./noblogs sauvegarder S    → sauvegarde complète
#   ./noblogs aide             → aide
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
VERSION="2.1.0-lite"

# --- Couleurs (désactivées si pas de terminal) ---
if [ -t 1 ]; then
  G="\033[0;32m"; R="\033[0;31m"; Y="\033[1;33m"; C="\033[0;36m"; N="\033[0m"
else
  G=""; R=""; Y=""; C=""; N=""
fi
ok()   { echo -e "  ${G}✓${N} $*"; }
warn() { echo -e "  ${Y}!${N} $*"; }
err()  { echo -e "  ${R}✗${N} $*" >&2; }
info() { echo -e "  ${C}→${N} $*"; }

# --- Langue ---
USER_LANG="${LANG:-}"
if [[ "$USER_LANG" == en* ]]; then
  L_ERR_PY="Python 3 is required."
  L_INFO_PY_MAC="Install it: xcode-select --install or brew install python3"
  L_INFO_PY_TAILS="On Tails: Applications → Utilities → Terminal (Python 3 is included)."
  L_INFO_PY_LINUX="Install it: sudo apt install python3 python3-venv python3-pip"
  L_INFO_ENV="First use: preparing the environment (1 to 2 min)…"
  L_OK_ENV="Environment ready."
elif [[ "$USER_LANG" == it* ]]; then
  L_ERR_PY="Python 3 è richiesto."
  L_INFO_PY_MAC="Installalo: xcode-select --install oppure brew install python3"
  L_INFO_PY_TAILS="Su Tails: Applicazioni → Utilità → Terminale (Python 3 è incluso)."
  L_INFO_PY_LINUX="Installalo: sudo apt install python3 python3-venv python3-pip"
  L_INFO_ENV="Primo utilizzo: preparazione dell'ambiente (1-2 min)…"
  L_OK_ENV="Ambiente pronto."
else
  L_ERR_PY="Python 3 est requis."
  L_INFO_PY_MAC="Installez-le : xcode-select --install  ou  brew install python3"
  L_INFO_PY_TAILS="Sur Tails : Applications → Utilitaires → Terminal (Python 3 est inclus)."
  L_INFO_PY_LINUX="Installez-le : sudo apt install python3 python3-venv python3-pip"
  L_INFO_ENV="Première utilisation : préparation de l'environnement (1 à 2 min)…"
  L_OK_ENV="Environnement prêt."
fi

detect_platform() {
  if [ -f /etc/amnesia ] || [ -n "${TAILS_VERSION:-}" ]; then
    echo "tails"
  elif [ "$(uname -s)" = "Darwin" ]; then
    echo "macos"
  else
    echo "linux"
  fi
}

venv_dir() {
  local plat
  plat="$(detect_platform)"
  if [ "$plat" = "tails" ] && [ -d "${HOME}/Persistent" ]; then
    echo "${HOME}/Persistent/noblogs-backup/.venv"
  else
    echo "${REPO_ROOT}/.venv"
  fi
}

ensure_python() {
  if ! command -v python3 >/dev/null 2>&1; then
    err "$L_ERR_PY"
    case "$(detect_platform)" in
      macos)  info "$L_INFO_PY_MAC" ;;
      tails)  info "$L_INFO_PY_TAILS" ;;
      *)      info "$L_INFO_PY_LINUX" ;;
    esac
    exit 1
  fi
}

ensure_venv() {
  ensure_python
  local VENV
  VENV="$(venv_dir)"
  if [ ! -x "$VENV/bin/python3" ]; then
    info "$L_INFO_ENV"
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --upgrade pip
    "$VENV/bin/pip" install -q -r "$REPO_ROOT/requirements.txt"
    ok "$L_OK_ENV"
  fi
  export NOBLOGS_VENV="$VENV"
}

main() {
  cd "$REPO_ROOT"
  if [ "${1:-}" = "version" ] || [ "${1:-}" = "-V" ] || [ "${1:-}" = "--version" ]; then
    echo "noblogs ${VERSION}"
    return 0
  fi
  ensure_venv
  exec "$NOBLOGS_VENV/bin/python3" ${PYTHONUTF8:+-X utf8} -m backup wizard "$@"
}

main "$@"